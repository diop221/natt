# Base de données Postgres.
# Supabase : Project Settings → Database → Connection string.
#   DATABASE_URL = « Transaction pooler » (port 6543), suivi de ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = « Session pooler » ou connexion directe (port 5432)
# Postgres local (docker, conteneur natt-postgres) :
DATABASE_URL="postgresql://postgres:natt@127.0.0.1:54329/natt"
DIRECT_URL="postgresql://postgres:natt@127.0.0.1:54329/natt"
PAYMENT_PROVIDER=mock
BITNOB_BASE_URL=
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Webhooks Bitnob : URL <APP_URL>/api/webhooks/bitnob à déclarer dans le tableau de bord, et son secret de signature
BITNOB_WEBHOOK_SECRET=

# Adresse publique de l'application (liens envoyés par WhatsApp)
APP_URL=http://localhost:3000
# Commission Natt sur chaque versement, en points de base (50 = 0,5 %)
NATT_FEE_BPS=50
# Blocs Bitcoin pour le tirage au sort : "mock" ou "mempool" (par défaut : mempool avec Bitnob, sinon mock)
CHAIN_PROVIDER=
# Tâche planifiée /api/cron/tick (rappels, pénalités) : appelée avec "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Messages WhatsApp : "mock" (enregistrés sur /dev/messages) ou "whatsapp" (API WhatsApp Cloud de Meta)
NOTIFY_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Menu USSD /api/ussd (Africa's Talking) : secret ajouté à l'URL de rappel (?secret=…)
USSD_SECRET=
# Autorise les clés Bitnob de production (argent réel). À ne mettre qu'en connaissance de cause.
BITNOB_ALLOW_LIVE=false
# Messages vocaux en wolof : service de synthèse vocale qui reçoit {"text", "language":"wol"} en JSON
# et renvoie un fichier audio (audio/ogg de préférence). Vide : les messages vocaux ne sont qu'enregistrés.
VOICE_TTS_URL=
VOICE_TTS_TOKEN=
# Natt Marchands : numéros des comptes de l'équipe Natt (séparés par des virgules), qui gèrent marchands et offres
NATT_ADMIN_PHONES=
# Attestations : clé de signature Ed25519 (32 octets en base64 : openssl rand -base64 32). Obligatoire avec Bitnob.
ATTESTATION_SIGNING_KEY=
# Prix d'une attestation en FCFA (0 = gratuite)
ATTESTATION_PRICE_XOF=2500
